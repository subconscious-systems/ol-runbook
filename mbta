#!/usr/bin/env bash
# mbta — Subconscious Inference System helper CLI
#
# Coding-agent install/run front door. Platform/bootstrap commands may be
# added later; this entrypoint is reserved for that expansion.
#
# Usage:
#   mbta self-install
#   mbta config --gateway-url URL --api-key KEY [--model MODEL]
#   mbta --profile staging cursor install
#   mbta claude-code run -- --continue

set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"

# Resolve the real entrypoint before sourcing helpers (PATH symlinks).
_mbta_resolve_self() {
  local entry="$1" resolved target
  resolved="$entry"
  while [[ -L "$resolved" ]]; do
    target="$(readlink "$resolved")"
    if [[ "$target" != /* ]]; then
      resolved="$(cd "$(dirname "$resolved")" && pwd)/$target"
    else
      resolved="$target"
    fi
  done
  echo "$(cd "$(dirname "$resolved")" && pwd)/$(basename "$resolved")"
}
MBTA_SCRIPT="$(_mbta_resolve_self "$SCRIPT_SOURCE")"
OL_RUNBOOK_ROOT="$(cd "$(dirname "$MBTA_SCRIPT")" && pwd)"
CODING_AGENTS_DIR="${OL_RUNBOOK_ROOT}/coding-agents"

# shellcheck source=coding-agents/lib/mbta-common.sh
source "${CODING_AGENTS_DIR}/lib/mbta-common.sh"
mbta_init_paths "$SCRIPT_SOURCE"

PROFILE="${MBTA_PROFILE:-default}"
BIN_DIR="${HOME}/.local/bin"

usage() {
  cat <<EOF
Usage:
  mbta [--profile NAME|-p NAME] <command> [args...]

Commands:
  self-install [--bin-dir DIR]   Symlink mbta onto PATH (default: ~/.local/bin)
  self-uninstall [--bin-dir DIR] Remove that symlink

  config [show|path|list|delete] [--gateway-url URL] [--api-key KEY] [--model MODEL]
                                 Manage shared gateway config for a profile
  config delete --profile NAME   Delete a named profile file

  <agent> install|status|uninstall [flags...]
  <agent> run [args...]          Launch (CLI agents) or print next steps (IDE)
  <agent> use|env|unset [...]    Claude Code / Codex persistent helpers

Agents:
  cursor, copilot (aliases: vscode, vs-code), claude-code (alias: claude),
  codex, opencode, pi

Profiles:
  default → coding-agents/.env
  NAME    → coding-agents/profiles/NAME.env
  Select with --profile / -p, or env MBTA_PROFILE (default: default).

Examples:
  mbta self-install
  mbta config --gateway-url https://gateway.example --api-key sk-gw-...
  mbta config --profile staging --gateway-url https://staging.example --api-key sk-gw-...
  mbta --profile staging cursor install
  mbta -p staging claude-code run

Platform/bootstrap commands are not wired yet; they will land on this CLI later.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

cmd_self_install() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bin-dir)
        [[ $# -ge 2 ]] || die "--bin-dir requires a directory"
        BIN_DIR="$2"
        shift 2
        ;;
      -h|--help)
        echo "Usage: mbta self-install [--bin-dir DIR]"
        return 0
        ;;
      *)
        die "unknown flag for self-install: $1"
        ;;
    esac
  done

  mkdir -p "$BIN_DIR"
  local target="${BIN_DIR}/mbta"
  if [[ -e "$target" || -L "$target" ]]; then
    if [[ -L "$target" ]]; then
      local existing
      existing="$(readlink "$target")"
      if [[ "$existing" == "$MBTA_SCRIPT" ]]; then
        echo "already installed: $target → $MBTA_SCRIPT"
      elif [[ "$(basename "$existing")" == "mbta" ]] || [[ "$existing" == *"/mbta" ]]; then
        ln -sf "$MBTA_SCRIPT" "$target"
        echo "updated: $target → $MBTA_SCRIPT"
      else
        die "$target exists and does not look like an mbta symlink (refusing to overwrite)"
      fi
    else
      die "$target exists and is not a symlink (refusing to overwrite)"
    fi
  else
    ln -s "$MBTA_SCRIPT" "$target"
    echo "installed: $target → $MBTA_SCRIPT"
  fi

  case ":$PATH:" in
    *":${BIN_DIR}:"*) ;;
    *)
      echo ""
      echo "Note: ${BIN_DIR} is not on your PATH. Add this to your shell rc:"
      echo "  export PATH=\"${BIN_DIR}:\$PATH\""
      ;;
  esac
}

cmd_self_uninstall() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bin-dir)
        [[ $# -ge 2 ]] || die "--bin-dir requires a directory"
        BIN_DIR="$2"
        shift 2
        ;;
      -h|--help)
        echo "Usage: mbta self-uninstall [--bin-dir DIR]"
        return 0
        ;;
      *)
        die "unknown flag for self-uninstall: $1"
        ;;
    esac
  done

  local target="${BIN_DIR}/mbta"
  if [[ ! -e "$target" && ! -L "$target" ]]; then
    echo "nothing to uninstall at $target"
    return 0
  fi
  if [[ -L "$target" ]]; then
    local existing
    existing="$(readlink "$target")"
    # Resolve existing to absolute for comparison when relative
    if [[ "$existing" != /* ]]; then
      existing="$(cd "$(dirname "$target")" && pwd)/$existing"
    fi
    if [[ "$existing" == "$MBTA_SCRIPT" ]]; then
      rm -f "$target"
      echo "removed: $target"
      return 0
    fi
    die "$target points elsewhere ($existing); not removing"
  fi
  die "$target is not a symlink; not removing"
}

cmd_config() {
  local sub=""
  local gateway_url="" api_key="" model=""
  local have_set=0

  # Allow --profile after `config` as well (in addition to global parse).
  while [[ $# -gt 0 ]]; do
    case "$1" in
      show|path|list|delete)
        sub="$1"
        shift
        ;;
      --profile|-p)
        [[ $# -ge 2 ]] || die "$1 requires a profile name"
        PROFILE="$2"
        shift 2
        ;;
      --gateway-url)
        [[ $# -ge 2 ]] || die "--gateway-url requires a value"
        gateway_url="$2"
        have_set=1
        shift 2
        ;;
      --api-key)
        [[ $# -ge 2 ]] || die "--api-key requires a value"
        api_key="$2"
        have_set=1
        shift 2
        ;;
      --model)
        [[ $# -ge 2 ]] || die "--model requires a value"
        model="$2"
        have_set=1
        shift 2
        ;;
      -h|--help)
        echo "Usage: mbta [--profile NAME] config [show|path|list|delete] [--gateway-url URL] [--api-key KEY] [--model MODEL]"
        return 0
        ;;
      *)
        die "unknown config argument: $1"
        ;;
    esac
  done

  case "$sub" in
    list)
      mbta_list_profiles
      return 0
      ;;
    delete)
      mbta_validate_profile_name "$PROFILE" || exit 1
      if [[ "$PROFILE" == "default" ]]; then
        die "refusing to delete the default profile; remove ${CODING_AGENTS_DIR}/.env manually if needed"
      fi
      local del_file
      del_file="$(mbta_profile_file "$PROFILE")" || exit 1
      if [[ ! -f "$del_file" ]]; then
        echo "profile '$PROFILE' not found at $del_file"
        return 0
      fi
      rm -f "$del_file"
      echo "deleted profile '$PROFILE' ($del_file)"
      return 0
      ;;
    path)
      mbta_profile_file "$PROFILE"
      return 0
      ;;
  esac

  # show (explicit or bare `config` with no set flags)
  if [[ $have_set -eq 0 ]]; then
    local file
    file="$(mbta_profile_file "$PROFILE")" || exit 1
    mbta_show_profile "$file" "$PROFILE"
    return 0
  fi

  # Set keys on the selected profile
  mbta_validate_profile_name "$PROFILE" || exit 1
  local file
  file="$(mbta_profile_file "$PROFILE")" || exit 1
  mbta_ensure_profile_file "$file"
  [[ -n "$gateway_url" ]] && mbta_upsert_env_key "$file" "GATEWAY_URL" "$gateway_url"
  [[ -n "$api_key" ]] && mbta_upsert_env_key "$file" "API_KEY" "$api_key"
  [[ -n "$model" ]] && mbta_upsert_env_key "$file" "MODEL" "$model"
  echo "updated profile '$PROFILE' → $file"
  mbta_show_profile "$file" "$PROFILE"
}

print_ide_run_help() {
  local agent="$1"
  local profile="$2"
  local file profile_flag=""
  file="$(mbta_profile_file "$profile")" || exit 1
  if [[ "$profile" != "default" ]]; then
    profile_flag=" --profile $profile"
  fi

  echo "Agent '$agent' has no ephemeral runner — use the IDE / app after install."
  echo "Profile: $profile ($file)"
  echo ""
  case "$agent" in
    cursor)
      cat <<EOF
Next steps:
  1. mbta${profile_flag} cursor install
  2. Fully restart Cursor so it reloads hooks.
  3. Cursor Settings → enable OpenAI API Key Override:
       Base URL = GATEWAY_URL from this profile
       API Key  = API_KEY from this profile
       Model    = MODEL from this profile (or dashboard)
EOF
      ;;
    copilot)
      cat <<EOF
Next steps:
  1. mbta${profile_flag} copilot install
  2. Fully quit and restart VS Code.
  3. Chat → Manage Language Models → Subconscious Gateway → key icon
     → paste your gateway API key (sk-gw-...).
EOF
      ;;
    pi)
      cat <<EOF
Next steps:
  1. mbta${profile_flag} pi install
  2. Restart Pi sessions so they pick up ~/.pi/agent/models.json.
EOF
      ;;
  esac
}

dispatch_agent() {
  local agent="$1"
  shift
  local action="${1:-}"
  if [[ -z "$action" || "$action" == "-h" || "$action" == "--help" ]]; then
    cat <<EOF
Usage: mbta [--profile NAME] $agent <action> [args...]

Actions:
  install [flags...]     Persistent setup (see $agent/install.sh)
  status | uninstall
EOF
    if mbta_agent_has_use "$agent"; then
      echo "  use [-- AGENT_ARGS...]  Launch with persistent env"
      echo "  env | unset             Print exports for sourcing"
    fi
    if mbta_agent_has_run_sh "$agent"; then
      echo "  run [args...]           Ephemeral launch (run.sh)"
    else
      echo "  run                     Print next-step instructions"
    fi
    return 0
  fi
  shift

  local env_file
  env_file="$(mbta_profile_file "$PROFILE")" || exit 1
  export MBTA_ENV_FILE="$env_file"

  local agent_dir="${CODING_AGENTS_DIR}/${agent}"
  local install_sh="${agent_dir}/install.sh"
  local run_sh="${agent_dir}/run.sh"

  case "$action" in
    install|status|uninstall|use|env|unset)
      [[ -x "$install_sh" || -f "$install_sh" ]] || die "missing $install_sh"
      chmod +x "$install_sh" 2>/dev/null || true
      exec env MBTA_ENV_FILE="$env_file" "$install_sh" "$action" "$@"
      ;;
    run)
      if mbta_agent_has_run_sh "$agent"; then
        [[ -f "$run_sh" ]] || die "missing $run_sh"
        chmod +x "$run_sh" 2>/dev/null || true
        exec env MBTA_ENV_FILE="$env_file" "$run_sh" "$@"
      else
        print_ide_run_help "$agent" "$PROFILE"
      fi
      ;;
    *)
      die "unknown action '$action' for agent '$agent' (try: install, status, uninstall, run)"
      ;;
  esac
}

# ── global flag parse ─────────────────────────────────────────────────────────
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile|-p)
      [[ $# -ge 2 ]] || die "$1 requires a profile name"
      PROFILE="$2"
      shift 2
      ;;
    --)
      shift
      ARGS+=("$@")
      break
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

CMD="$1"
shift

case "$CMD" in
  self-install)
    cmd_self_install "$@"
    ;;
  self-uninstall)
    cmd_self_uninstall "$@"
    ;;
  config)
    cmd_config "$@"
    ;;
  cursor|copilot|vscode|vs-code|claude-code|claude|codex|opencode|pi)
    AGENT="$(mbta_resolve_agent "$CMD")" || die "unknown agent: $CMD"
    dispatch_agent "$AGENT" "$@"
    ;;
  *)
    die "unknown command '$CMD' (try: mbta --help)"
    ;;
esac
