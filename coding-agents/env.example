# Subconscious API Gateway - shared config for all coding agents
#
# Copy this file to .env and paste in your values. .env is gitignored.
# All install.sh and run.sh scripts in subdirectories read from this file.
#
#   cp env.example .env
#   # edit .env, then:
#   ./codex/install.sh
#   ./claude-code/install.sh
#   ./cursor/install.sh
#   ./opencode/install.sh
#   ./pi/install.sh
#
# Precedence for credentials:
#   1. CLI --api-key on install.sh / run.sh (one-off for that invocation)
#   2. Agent-prefixed override (OPENCODE_API_KEY, CLAUDE_CODE_API_KEY, ...)
#   3. Shared API_KEY below
#
# Precedence for other agent settings (context / compaction):
#   1. CLI flags on install.sh / run.sh
#   2. Agent-prefixed vars below (OPENCODE_*, CLAUDE_CODE_*, CODEX_*, ...)
#   3. Script hardcoded defaults
#
# Context / compaction limits are per-agent - there is no shared
# CONTEXT_LIMIT. Cursor has no context override today.

# Gateway origin (e.g. https://gateway.example.com)
GATEWAY_URL=

# Shared gateway API key (sk-gw-...). Prefer a TIMRUN-reporting key here for
# Claude Code / Codex / Cursor. Override per agent below when you want a
# different key (e.g. Full list for OpenCode / Pi / Copilot).
API_KEY=

# Optional per-agent API key overrides (leave unset to use API_KEY).
# Typical dual-key setup (create two keys in the dashboard):
#   API_KEY=<timrun-reporting-key>
#   OPENCODE_API_KEY=<full-list-reporting-key>
#   PI_API_KEY=<full-list-reporting-key>
#   COPILOT_API_KEY=<full-list-reporting-key>   # hooks; Chat key still via VS Code UI
# OPENCODE_API_KEY=
# CLAUDE_CODE_API_KEY=
# CODEX_API_KEY=
# PI_API_KEY=
# COPILOT_API_KEY=
# CURSOR_API_KEY=

# Model name
MODEL=gw-glm-5.2

# Optional: Claude Code only - use a different origin than GATEWAY_URL
# (e.g. direct local gateway while others use the HTTPS proxy tunnel).
# CLAUDE_GATEWAY_URL=http://127.0.0.1:31080

# ── Per-agent context / compaction ──
# Pair with dashboard Client context reporting: TIMRUN (new-key default) for
# Claude/Codex/Cursor; Full list for OpenCode/Pi/Copilot. See coding-agents/README.md.

# OpenCode: no model context/output limit is injected; OpenCode defaults apply.

# Claude Code: leave auto-compact on. Product caps AUTO_COMPACT_WINDOW at 1M
# (https://code.claude.com/docs/en/env-vars ,
#  https://code.claude.com/docs/en/context-window#set-the-auto-compact-window).
# With a TIMRUN-reporting key, usage stays ~≤150k so auto-compact rarely fires;
# use /compact manually on 32 MB payload errors or high latency.
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000
# CLAUDE_CODE_MAX_CONTEXT_TOKENS=3000000

# Codex: model-catalog.json windows (auto_compact ~90% of context by default)
# CODEX_CONTEXT_WINDOW=5000000
# CODEX_MAX_CONTEXT_WINDOW=5000000
# CODEX_AUTO_COMPACT_TOKEN_LIMIT=4500000

# Pi: models.json contextWindow / maxTokens
# PI_CONTEXT_WINDOW=5000000
# PI_MAX_TOKENS=65536

# Copilot (VS Code Custom Endpoint): maxInputTokens / maxOutputTokens
# COPILOT_MAX_INPUT_TOKENS=5000000
# COPILOT_MAX_OUTPUT_TOKENS=65536

# Cursor: no context / compaction env - custom models assume ~1M in the product UI.

# Claude Code OTEL purpose attribution (query_source) is configured in
# claude-code/run.sh and claude-code/install.sh. Gateway POST /v1/logs is
# Claude Code-only (api_request events); see:
# https://code.claude.com/docs/en/monitoring-usage#api-request-event
