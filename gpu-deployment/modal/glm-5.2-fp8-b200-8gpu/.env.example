# Copy this file to .env inside this profile directory.
# Choose an image with the GLM/DFLASH/fa4 runtime and bundled chat template.
ORANGELINE_IMAGE_NAME=subconsciouslabs/enter-image-tag-here

# The registry secret stores these keys for Modal Image.from_registry.
DOCKER_TOKEN_SECRET=SUBCONSCIOUS_DOCKERHUB
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Needed by the CPU job that downloads both the main and gated draft model.
HF_TOKEN_SECRET=SUBCONSCIOUS_HF_TOKEN
HF_TOKEN=
