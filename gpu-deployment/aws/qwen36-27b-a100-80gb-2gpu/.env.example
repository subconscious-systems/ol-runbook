# qwen36-27b-a100-80gb-2gpu on AWS: 2 x a100-80gb; 1 worker(s).
# Copy to .env. deploy.sh reads literal KEY=value assignments from that file.
# Use absolute paths: shell variables, ~, and command substitutions are not expanded.
# Nonempty process environment variables override these defaults.
# No secrets are included. Keep .env out of git.
# AWS_INSTANCE_TYPE: empty means no profile-specific override.
SSH_USER=ubuntu
SSH_KEY=
SSH_PORT=22
INSTANCE_NAME=
AWS_INSTANCE_TYPE=
AWS_REGION=us-east-1
AMI_ID=
KEY_NAME=
SUBNET_ID=
SG_ID=
DISK_GB=1024
