# glm-5.2-b200-4gpu on GCP: 4 x b200; 1 worker(s).
# Copy to .env. deploy.sh reads literal KEY=value assignments from that file.
# Use absolute paths: shell variables, ~, and command substitutions are not expanded.
# Nonempty process environment variables override these defaults.
# No secrets are included. Keep .env out of git.
# GCP_MACHINE_TYPE: empty means no profile-specific override.
SSH_USER=ubuntu
SSH_KEY=
SSH_PORT=22
INSTANCE_NAME=
GCP_MACHINE_TYPE=
GCP_PROJECT=
GCP_ZONE=
GCP_NETWORK=default
GCP_IMAGE_FAMILY=ubuntu-2204-lts-amd64
GCP_IMAGE_PROJECT=ubuntu-os-cloud
DISK_GB=1024
