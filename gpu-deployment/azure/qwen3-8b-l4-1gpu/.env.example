# qwen3-8b-l4-1gpu on Azure: 1 x l4; 1 worker(s).
# Copy to .env. deploy.sh reads literal KEY=value assignments from that file.
# Use absolute paths: shell variables, ~, and command substitutions are not expanded.
# Nonempty process environment variables override these defaults.
# No secrets are included. Keep .env out of git.
# AZURE_VM_SIZE: empty means no profile-specific override.
SSH_USER=azureuser
SSH_KEY=
SSH_PORT=22
INSTANCE_NAME=
AZURE_VM_SIZE=
AZ_RESOURCE_GROUP=
AZ_LOCATION=eastus
AZ_IMAGE=Canonical:0001-com-ubuntu-server-jammy:22_04-lts-amd64:latest
DISK_GB=1024
