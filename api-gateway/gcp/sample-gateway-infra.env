# Sample api-gateway-infra Distr Docker environment for GCP.
#
# This mirrors api-gateway-infra/runner/template.gcp.env. Compare it with the
# exact template shipped by the selected runner release before deployment.
# Paste into the api-gateway-infra Distr Docker deployment environment and
# adapt the project, DNS, CIDR, deployment, provider-route, and Datadog values.
#
# Never commit a populated copy or any resolved secret value.

# --- HUB SECRETS ---

DISTR_TOKEN={{.Secrets.DISTR_TOKEN}}
DD_API_KEY={{.Secrets.DD_API_KEY}}
DD_APP_KEY={{.Secrets.DD_APP_KEY}}

# Optional. Leave empty when dashboard bootstrap/OIDC is disabled.
DASHBOARD_BOOTSTRAP_PASSWORD={{.Secrets.GATEWAY_DASHBOARD_BOOTSTRAP_PASSWORD}}
DASHBOARD_OIDC_CLIENT_SECRET=

# --- ENVIRONMENT IDENTITY ---

CLOUD=gcp
DEPLOY_NAME=acme-prod-gw-infra
GATEWAY_DISTR_DEPLOYMENT_NAME=acme-prod-gateway

GCP_PROJECT=acme-gateway-prod
GCP_REGION=us-east1
# Existing public Cloud DNS zone project; it is separate from GCP_PROJECT.
GCP_DNS_PROJECT_ID=acme-shared-dns

DOMAIN_NAME=api.example.com
# Cloud DNS managed-zone resource name, not its DNS suffix.
DNS_ZONE_NAME=example-public
# Bucket created by the bootstrap stack. Leave empty only when accepting the
# runner default GCP_PROJECT-subconscious-tfstate.
TF_STATE_BUCKET=acme-gateway-prod-subconscious-tfstate

# --- REGIONAL GKE STANDARD / ARM ---

# Leave empty to follow the release channel. Pin only after checking the live
# versions offered in us-east1 and reviewing the release's qualification data.
GKE_VERSION=
GKE_RELEASE_CHANNEL=REGULAR
GCP_NODE_MACHINE_TYPE=n4a-standard-4

# Totals across the two platform-owned us-east1 node locations.
NODE_DESIRED_SIZE=2
NODE_MIN_SIZE=2
NODE_MAX_SIZE=4

# Canonical non-overlapping RFC1918 /16. Terraform derives every platform
# subnet/range from this value.
VPC_CIDR=10.60.0.0/16

# Required for the IAM-protected DNS endpoint design.
CLUSTER_ENDPOINT_PUBLIC_ACCESS=false
CLUSTER_ENDPOINT_PUBLIC_ACCESS_CIDRS=

# --- CLOUD SQL POSTGRESQL 16 / MEMORYSTORE REDIS 7 ---

CLOUDSQL_TIER=db-custom-2-7680
CLOUDSQL_STORAGE_GB=50
MEMORYSTORE_MEMORY_GB=5
GCP_DELETION_PROTECTION=true

# Terraform owns the deterministic Cloud DNS A record.
GCP_EXTERNAL_DNS_ENABLED=false

# --- DATADOG ---

DATADOG_ENABLED=true
DATADOG_SITE=datadoghq.com
DATADOG_ENV=acme-gateway-prod

# Keyless GCP STS integration and GCP/GKE/database cloud metrics.
DATADOG_GCP_CLOUD_METRICS_ENABLED=true

# Stage DBM in two applies: prerequisites first, then the direct check.
DATADOG_POSTGRES_DBM_PREREQUISITES_ENABLED=false
DATADOG_POSTGRES_DBM_ENABLED=false
DATADOG_POSTGRES_DBM_BOOTSTRAP_REVISION=1

# Enable only after Cloud SQL and Redis metrics are present; keep draft while
# thresholds are baselined.
DATADOG_DATABASE_MONITORS_ENABLED=false
DATADOG_DATABASE_MONITORS_DRAFT=true

DATADOG_MONITORS_DRAFT=true
DATADOG_INCLUDE_ROUTER_MONITORS=true
DATADOG_INCLUDE_ADAPTER_MONITORS=true
DATADOG_SLOS_ENABLED=false
DATADOG_MONITOR_NOTIFICATION=

# --- GATEWAY DEPLOYMENT ---

# First infra pass: false. Set true only after the Distr Kubernetes agent is
# healthy in GATEWAY_DISTR_DEPLOYMENT_NAME.
GATEWAY_AUTO_DEPLOY=false
# latest (default) | nochange | version name such as 0.15.0
GATEWAY_CHART_VERSION=latest
DISTR_GATEWAY_APPLICATION_ID=df563de2-25e4-4d8b-b24c-53bb4ad11086
DISTR_GATEWAY_APPLICATION_VERSION_ID=

# Production + adapter requires at least one external provider DNS suffix.
GATEWAY_ROUTE_ALLOWED_HOST_SUFFIXES=customer.example,api.baseten.co

DASHBOARD_BOOTSTRAP_USERNAME=admin
DASHBOARD_BOOTSTRAP_ORG_NAME=Acme
DASHBOARD_BOOTSTRAP_FULL_NAME=Gateway Admin

DASHBOARD_OIDC_ENABLED=false
DASHBOARD_OIDC_PROVIDER=generic
DASHBOARD_OIDC_ISSUER_URL=
DASHBOARD_OIDC_CLIENT_ID=
DASHBOARD_OIDC_REDIRECT_URI=
DASHBOARD_OIDC_SCOPES=openid,email,profile

# 1 = Terraform plan only. Normal AWS-style installation uses 0.
DISTR_DRY_RUN=0
