# Copy to terraform.tfvars and replace every example value.
# terraform.tfvars is ignored by git.

# Set exactly one parent.
organization_id = "123456789012"
# folder_id = "123456789012"

billing_account_id = "000000-000000-000000"

# Optional existing project used to bill client-based API quota while these
# projects are being created. Leave empty if your ADC setup already has one.
quota_project_id = "acme-platform-admin"

# Create only sandbox first. Add "prod" after the sandbox rebuild evidence is
# approved and immediately review the production-only plan.
enabled_environments = ["sandbox"]

# Reserve both globally unique IDs up front; only enabled projects are created.
sandbox_project_id       = "acme-gateway-sbox"
production_project_id    = "acme-gateway-prod"
sandbox_project_name     = "Acme Gateway Sandbox"
production_project_name  = "Acme Gateway Production"

# Deployment-type feature selection. Leave the set empty when Domain
# Restricted Sharing is not enforced. When it is enforced, select the gateway
# environments that need a project-only Datadog exception and copy every
# customer ID from the effective parent policy. Terraform preserves them and
# adds Datadog's commercial identity C0147pk0i.
datadog_domain_restricted_sharing_environments = []
domain_restricted_sharing_existing_customer_ids = [
  # "C0123example",
]
# Government Datadog sites use C03lf3ewa instead.
datadog_customer_identity = "C0147pk0i"

# Alerts are sent to default billing-account/project recipients. These are not
# hard caps; replace with approved Calculator-based whole-dollar amounts.
monthly_budget_amounts_usd = {
  sandbox = 1200
  prod    = 1200
}

# Locked region. The bootstrap VMs can use any supported us-east1 zone.
region = "us-east1"
bootstrap_zones = {
  sandbox = "us-east1-b"
  prod    = "us-east1-c"
}

bootstrap_subnet_cidrs = {
  sandbox = "10.40.0.0/24"
  prod    = "10.41.0.0/24"
}

bootstrap_machine_type = "e2-standard-2"
bootstrap_disk_size_gb = 40

# Use groups for day-2 access where possible.
operator_principals = [
  "group:gateway-platform@example.com",
]

# Keep protections enabled until the approved final teardown.
project_deletion_policy = "PREVENT"
protect_bootstrap_vms   = true

labels = {
  application = "subconscious-gateway"
  managed-by  = "terraform"
  owner       = "platform"
}
