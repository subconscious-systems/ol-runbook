# Sample Distr Docker env - api-dev.subconscious.dev
#
# Paste into the api-gateway-infra Distr Docker deployment environment.
# Day-0 host: api-gateway/aws/bootstrap (instance profile; no AWS keys in Hub).
# Full procedure: instructions.md · Secrets: gateway-secrets.md · FAQ: ../../FAQ.md
#
# Hub path (summary):
#   1. Bootstrap EC2 + connect Distr Docker agent
#   2. Create Hub Secrets: DISTR_TOKEN, DD_API_KEY, DD_APP_KEY,
#      optional GATEWAY_DASHBOARD_BOOTSTRAP_PASSWORD, and
#      AWS_GATEWAY_DASHBOARD_OIDC_CLIENT_SECRET when OIDC is enabled
#   3. Paste this file into the infra Docker deployment env
#   4. Keep gateway auto-deploy disabled for the first apply and EKS hop
#   5. Connect Distr Kubernetes agent with DEPLOY_NAME as the explicit EKS
#      cluster and GATEWAY_DISTR_DEPLOYMENT_NAME as namespace + Helm release
#   6. Re-run with GATEWAY_AUTO_DEPLOY=true and GATEWAY_CHART_VERSION=latest
#
# Do not commit real secret values.
# Avoid putting curly-brace Secrets expressions in comments (Distr parses the
# whole file as a Go template).

# --- SECRETS (Hub Secrets refs) ---

DISTR_TOKEN={{.Secrets.DISTR_TOKEN}}

# Required when DATADOG_ENABLED=true
DD_API_KEY={{.Secrets.DD_API_KEY}}
DD_APP_KEY={{.Secrets.DD_APP_KEY}}

# Optional first dashboard admin (12+ chars). Create Hub Secret
# GATEWAY_DASHBOARD_BOOTSTRAP_PASSWORD, then reference it here. Leave empty to
# skip.
DASHBOARD_BOOTSTRAP_PASSWORD={{.Secrets.GATEWAY_DASHBOARD_BOOTSTRAP_PASSWORD}}

# Required by the enabled Okta configuration below.
DASHBOARD_OIDC_CLIENT_SECRET={{.Secrets.AWS_GATEWAY_DASHBOARD_OIDC_CLIENT_SECRET}}

# --- PLATFORM ---

CLOUD=aws
DEPLOY_NAME=api-gateway-awsgateway
DOMAIN_NAME=awsgateway.orangelinelabs.com
DNS_ZONE_NAME=orangelinelabs.com
# Optional dashboard-only IP lock. Comma-separated list of up to three public
# browser IPv4 addresses (no /32 suffix); leave empty for a public dashboard.
# Helm owns the Ingress rules for this list. Re-run infra after changing it.
# /admin/v1, /v1, health, and other paths remain unaffected.
DASHBOARD_ALLOWED_IPS=

AWS_REGION=us-east-2
AWS_PROJECT=api-gateway
# Optional; default is account-id-subconscious-tfstate
TF_STATE_BUCKET=

# This staged release supports the 1.34 -> 1.35 hop (or a 1.35 reapply) only.
# Do not select a later version without a separately validated release.
KUBERNETES_VERSION=1.35
NODE_INSTANCE_TYPES=m7g.xlarge
NODE_DESIRED_SIZE=2
NODE_MIN_SIZE=2
NODE_MAX_SIZE=4
RDS_INSTANCE_CLASS=db.m7g.large
RDS_STORAGE_TYPE=gp3
RDS_APPLY_IMMEDIATELY=false

# Dedicated VPC CIDR. Pick a /16 that does not overlap other VPCs in this
# account (needed if you later peer or share routing). Not auto-detected.
VPC_CIDR=10.60.0.0/16

# Day-0: true. Leave CLUSTER_ENDPOINT_PUBLIC_ACCESS_CIDRS empty unless you need extra CIDRs; the runner fills this host's /32.
CLUSTER_ENDPOINT_PUBLIC_ACCESS=true
CLUSTER_ENDPOINT_PUBLIC_ACCESS_CIDRS=

DATADOG_ENABLED=true
GATEWAY_LOG_LEVEL=WARN
DATADOG_APM_ENABLED=false
DATADOG_LLM_OBS_ENABLED=false
# Orange Line Labs Datadog site (US5)
DATADOG_SITE=us5.datadoghq.com
# Keep the database AWS tags, dashboard filters, and monitor queries identical.
DATADOG_ENV=api-gateway-awsgateway

# PostgreSQL DBM: one flag. Role, CREATE EXTENSION, Agent check. No RDS reboot.
DATADOG_POSTGRES_DBM_ENABLED=false
# Optional. Increment only to replace a failed or orphaned DBM bootstrap Job.
# DATADOG_POSTGRES_DBM_BOOTSTRAP_REVISION=1
# Database CloudWatch/DBM monitors stay draft until you set this false after a
# traffic baseline.
# DATADOG_DATABASE_MONITORS_DRAFT=true

# US5 often restricts dashboard tag keys; default team:api-gateway is enough.
# Uniqueness across deploys is the title prefix [DATADOG_ENV].
# DATADOG_DASHBOARD_TAGS=team:api-gateway
DATADOG_MONITOR_NOTIFICATION=
DATADOG_MONITORS_DRAFT=false
DATADOG_INCLUDE_ROUTER_MONITORS=true
DATADOG_INCLUDE_ADAPTER_MONITORS=true

# Defaults to DEPLOY_NAME when empty. Kubernetes namespace and Helm release.
GATEWAY_DISTR_DEPLOYMENT_NAME=
# Optional Hub Kubernetes target name after a Hub-only rename. Empty = cluster identity.
GATEWAY_DISTR_PORTAL_NAME=
# latest (default) | nochange | semver name like 0.15.0
GATEWAY_CHART_VERSION=latest
# The Kubernetes target already exists for this deployed environment.
GATEWAY_AUTO_DEPLOY=true

# Provider DNS suffixes for this deploy (required for production+adapter).
# Matches the suffix and any subdomain (e.g. l4-a.subconscious.dev).
GATEWAY_ROUTE_ALLOWED_HOST_SUFFIXES=subconscious.dev,api.baseten.co,orangelinelabs.com

# Optional additional public hostnames on this AWS ALB. DNS stays owned by the
# hostname's authoritative provider. Request and validate each certificate in
# AWS_REGION before setting its ARN here. Comma-separated or JSON lists.
GATEWAY_EXTRA_INGRESS_HOSTS=
GATEWAY_EXTRA_ACM_CERTIFICATE_ARNS=

# Used when DASHBOARD_BOOTSTRAP_PASSWORD is set
DASHBOARD_BOOTSTRAP_EMAIL=admin@local.dev
DASHBOARD_BOOTSTRAP_ORG_NAME=Orange Line Labs
DASHBOARD_BOOTSTRAP_FULL_NAME=Gateway Admin

# Okta OIDC
DASHBOARD_OIDC_ENABLED=true
DASHBOARD_OIDC_PROVIDER=okta
DASHBOARD_OIDC_ISSUER_URL=https://integrator-1043260.okta.com
DASHBOARD_OIDC_CLIENT_ID=0oa15o0k3qo2b3DPy698
DASHBOARD_OIDC_REDIRECT_URI=
DASHBOARD_OIDC_SCOPES=openid,email,profile

# Subconscious-published api-gateway Helm Application (leave as-is unless forking)
DISTR_GATEWAY_APPLICATION_ID=df563de2-25e4-4d8b-b24c-53bb4ad11086
# Rare UUID override; prefer GATEWAY_CHART_VERSION instead
DISTR_GATEWAY_APPLICATION_VERSION_ID=

# 1 = terraform plan only
DISTR_DRY_RUN=0
